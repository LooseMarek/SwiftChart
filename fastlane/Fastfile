default_platform(:ios)

platform :ios do

  desc "Build and test the Swift package for iOS Simulator"
  lane :test do |options|
    destination = options[:destination] || "platform=iOS Simulator,name=iPhone 17 Pro"
    run_tests(
      package_path: ".",
      scheme: "SwiftChart",
      destination: destination,
      result_bundle: true
    )
  end

  desc "Build the Demo app for iOS Simulator"
  lane :demo_ios_build do |options|
    destination = options[:destination] || "platform=iOS Simulator,name=iPhone 17 Pro"
    sh(
      "xcodebuild", "build",
      "-project", "../demo/SwiftChartDemo.xcodeproj",
      "-scheme", "SwiftChartDemo",
      "-destination", destination
    )
  end

end
